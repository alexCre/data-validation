# Copy to .env and fill in to enable the Rule Authoring / Capability
# Extension agents against the real Anthropic API. Without this set, the
# Streamlit app falls back to the offline MockProvider (agents still work
# for demo purposes, but with keyword heuristics instead of a real LLM).
# Deterministic C1-C11 validation works either way - it never calls an LLM.
ANTHROPIC_API_KEY=

# Model id used by agents.providers.anthropic_provider.AnthropicProvider.
# Never hard-coded elsewhere in the codebase.
DMRV_LLM_MODEL=claude-sonnet-5

# Set to true to show the "Generate Operator Draft" developer-mode control
# on the Rules page's Capability Gap panel.
DEVELOPER_MODE=false
